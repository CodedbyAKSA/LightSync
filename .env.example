# LightSync Safety Console — server-side configuration.
# Copy to .env (git-ignored) and fill in. Placeholders only: never commit real values.
# None of these are exposed to the browser. Do NOT create VITE_* variables for secrets.

# ---- mode ------------------------------------------------------------------
# demo = deterministic simulated data (clearly labelled), live = real hardware
LIGHTSYNC_MODE=demo
# Live data source: blynk = poll Blynk Cloud, device = the car POSTs to /api/device/telemetry
# (see docs/CAR_HTTP_SETUP.md and firmware/lightsync_car/)
LIGHTSYNC_LIVE_SOURCE=blynk
# Shared secret the car sends as X-Device-Key (device source only). Not the operator key.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LIGHTSYNC_DEVICE_KEY=
# true = replace the car's accelerometer/gyro with simulated motion (device source only)
LIGHTSYNC_SIMULATE_MOTION=false
LIGHTSYNC_DEVICE_ID=lightsync-gateway-01
LIGHTSYNC_LOG_LEVEL=INFO
LIGHTSYNC_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Operator key for state-changing requests (commands, thresholds, mode switch).
# Required in live mode. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
LIGHTSYNC_API_KEY=

# ---- Blynk -----------------------------------------------------------------
# Device auth token from Blynk Console → Device → Device Info. Server-side only.
BLYNK_TOKEN=
# Your region's host, shown at the bottom right of Blynk Console (e.g. blynk.cloud, fra1.blynk.cloud, sgp1.blynk.cloud)
BLYNK_SERVER=blynk.cloud
BLYNK_POLL_INTERVAL=2
BLYNK_TIMEOUT=5
BLYNK_CONNECTED_CHECK_INTERVAL=10

# Telemetry older than this (no change in heartbeat / any value) is shown as STALE.
TELEMETRY_FRESHNESS_SECONDS=15
HISTORY_MAX_SAMPLES=3600
EVENTS_MAX=500

# ---- remote commands -------------------------------------------------------
# Off by default. Commands also need PIN_CMD_* below and the matching state pins.
COMMANDS_ENABLED=false
COMMAND_ACK_TIMEOUT=8

# ---- datastream → virtual pin mapping ---------------------------------------
# Defaults are SUGGESTIONS; make them match your Blynk template and firmware.
# Use "none" for fields your hardware does not publish (they show as Unavailable).
PIN_BATTERY_VOLTAGE=V0
PIN_BATTERY_CURRENT=V1
PIN_BATTERY_SOC=V2
PIN_BATTERY_SOH=V3
PIN_ACCEL_X=V4
PIN_ACCEL_Y=V5
PIN_ACCEL_Z=V6
PIN_GYRO_X=V7
PIN_GYRO_Y=V8
PIN_GYRO_Z=V9
PIN_OBSTACLE_DISTANCE=V10
PIN_IR_OBSTACLE=V11
PIN_OBSTACLE_DISTANCE_REAR=none
PIN_OBSTACLE_DISTANCE_LEFT=none
PIN_OBSTACLE_DISTANCE_RIGHT=none
PIN_IR_LEFT=none
PIN_IR_RIGHT=none
PIN_VIBRATION=V12
PIN_DROWSINESS=V13
PIN_RISK_SCORE=V14
PIN_ESPNOW_LINK=V15
PIN_LCD_STATUS=V16
PIN_AUTONOMOUS_MODE=V17
PIN_EMERGENCY_STOP=V18
PIN_BLUETOOTH_LINK=none
PIN_ESPNOW_RSSI=none
PIN_ESPNOW_PACKET_LOSS=none
PIN_HEARTBEAT=none
# Write-only request pins (must differ from the state pins above)
PIN_CMD_AUTONOMOUS_MODE=none
PIN_CMD_EMERGENCY_STOP=none

# ---- thresholds (startup values; editable at runtime in Settings) -----------
THRESHOLD_OBSTACLE_WARNING_CM=50
THRESHOLD_OBSTACLE_CRITICAL_CM=20
THRESHOLD_BATTERY_WARNING_PCT=20
THRESHOLD_BATTERY_CRITICAL_PCT=10
THRESHOLD_BATTERY_MIN_VOLTAGE=10.5
THRESHOLD_SOH_WARNING_PCT=70
THRESHOLD_ABNORMAL_ACCEL_MS2=15
THRESHOLD_ABNORMAL_GYRO_DPS=250
